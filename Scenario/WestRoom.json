{
    "west-room":[
        {"type":"text", "text":"四方が大きな本棚に囲まれた部屋だ。", "progression":"click"},
        {"type":"conditional",
         "conditions":[
            {"flags":[{"category":"items", "flag":"candle_out", "value":true}], "next":"west-room_light_off"},
            {"flags":[{"category":"items", "flag":"candle_goes_out", "value":0, "not":true}], "next":"west-room_light_off"},
            {"flags":[{"category":"items", "flag":"candle_goes_out", "value":0}], "next":"west-room_light_on"}
        ]}
    ],
    "west-room_light_on":[
        {"type":"text", "text":"中央には古い机があり、\nその上にあるキャンドル皿に乗せられたろうそくが\nうっすらと部屋を照らしている。", "progression":"click"}
    ],
    "west-room_light_off":[
        {"type":"text", "text":"明かりがないのでよく見えない。\n探し物は難しそうだ。", "progression":"click"}
    ],
    "BookShelf":[
        {"type":"text", "text":"大きな本棚がある。", "progression":"click"},
        {"type":"conditional",
        "conditions":[
            {"flags":[{"category":"items", "flag":"bookshelf_objective", "value":true}],
             "next":"BookShelf_flag_objective"},
            {"flags":[{"category":"items", "flag":"book_found", "value":true}],
             "next":"BookShelf_book_found"},
            {"flags":[
                {"category":"items", "flag":"book_found", "value":false},
                {"category":"items", "flag":"bookshelf_objective", "value":false}
                ], "next":"BookShelf_book_no_flag"}
        ]}
    ],
    "BookShelf_flag_objective":[
        {"type":"text", "text":"本棚にはいろんな本が丁寧に収められていて、\nどれもジャンルがバラバラのようだ。", "progression":"click"},
        {"type":"conditional",
        "conditions":[
            {"flags":[{"category":"items", "flag":"book_found", "value":false}], "next":"BookShelf_book_not_found"}
           ]}
    ],
    "BookShelf_book_not_found":[
        {"type":"interaction",
         "interactions":[
            {"text":"図書館", "next":"BookShelf_library"}
        ]}
    ],
    "BookShelf_book_found":[
        {"type":"interaction",
         "interactions":[
           {"text":"目星", "next":"BookShelf_objective"}
        ]}
    ],
    "BookShelf_book_no_flag":[
        {"type":"interaction",
          "interactions":[
             {"text":"目星", "next":"BookShelf_objective"},
             {"text":"図書館", "next":"BookShelf_library"}
          ]}
    ],
    "BookShelf_objective":[
        {"type":"conditional",
         "conditions":[
            {"flags":[{"category":"items", "flag":"candle_out", "value":false}], "next":"BookShelf_objective_dark"},
            {"flags":[{"category":"items", "flag":"candle_goes_out", "value":0, "not":true}], "next":"BookShelf_objective_dark"},
            {"flags":[{"category":"items", "flag":"candle_goes_out", "value":0}], "next":"BookShelf_objective_clear"}
        ]}
    ],
    "BookShelf_objective_dark":[
        {"type":"dice_check", "check_type":"skill", "skill":"目星", "dice":"1d100", "half":true,
         "success":"BookShelf_objective_success",
         "failure":"BookShelf_objective_failure"},
        {"type":"action", "action":"time_passage", "time":5}
    ],
    "BookShelf_objective_clear":[
        {"type":"dice_check", "check_type":"skill", "skill":"目星", "dice":"1d100",
         "success":"BookShelf_objective_success",
         "failure":"BookShelf_objective_failure"},
        {"type":"action", "action":"time_passage", "time":5}
    ],
    "BookShelf_objective_success":[
        {"type":"text", "text":"《目星》⇒ 成功！ <color=blue>{player_roll}<color/>/{player_threshold}", "progression":"click"},
        {"type":"action", "action":"set_flag", "category":"items", "flag":"bookshelf_objective", "value":true},
        {"type":"text", "text":"本棚にはいろんな本が丁寧に収められている。\nどれもジャンルがバラバラのものばかりのようだ。", "progression":"click"}
    ],
    "BookShelf_objective_failure":[
        {"type":"text", "text":"《目星》⇒ 失敗！ <color=red>{player_roll}<color/>/{player_threshold}", "progression":"click"},
        {"type":"text", "text":"本がたくさん詰まっている。", "progression":"click"}
    ],
    "BookShelf_library":[
        {"type":"conditional",
         "conditions":[
            {"flags":[{"category":"items", "flag":"candle_out", "value":false}], "next":"BookShelf_library_dark"},
            {"flags":[{"category":"items", "flag":"candle_goes_out", "value":0, "not":true}], "next":"BookShelf_library_dark"},
            {"flags":[{"category":"items", "flag":"candle_goes_out", "value":0}], "next":"BookShelf_library_clear"}
        ]}
    ],
    "BookShelf_library_dark":[
        {"type":"dice_check", "check_type":"skill", "skill":"図書館", "dice":"1d100", "half":true,
         "success":"BookShelf_library_success",
         "failure":"BookShelf_library_failure"},
        {"type":"action", "action":"time_passage", "time":10}
    ],
    "BookShelf_library_clear":[
        {"type":"dice_check", "check_type":"skill", "skill":"図書館", "dice":"1d100",
         "success":"BookShelf_library_success",
         "failure":"BookShelf_library_failure"},
        {"type":"action", "action":"time_passage", "time":10}
        ],
    "BookShelf_library_success":[
        {"type":"text", "text":"《図書館》⇒ 成功！ <color=blue>{player_roll}<color/>/{player_threshold}", "progression":"click"},
        {"type":"image_display", "image":"Book.png"},
        {"type":"text", "text":"『スープの夢について』と書かれた\n真っ黒な本を見つけた。", "progression":"click"},
        {"type":"text", "text":"本はべったりと湿っていて、\n本を手に取ると黒い液体が\n付着した。", "progression":"click"},
        {"type":"action", "action":"set_flag", "category":"items", "flag":"book_found", "value":true},
        {"type":"next_step", "next":"Black_liquid"}
    ],
    "BookShelf_library_failure":[
        {"type":"text", "text":"《図書館》⇒ 失敗！ <color=red>{player_roll}<color/>/{player_threshold}", "progression":"click"},
        {"type":"text", "text":"何も見つけられなかった。", "progression":"click"}
    ],
    "Black_liquid":[
        {"type":"text", "text":"《博物学》⇒", "progression":"click"},
        {"type":"dice_check", "check_type":"skill", "skill":"博物学", "dice":"1d100",
         "success":"Black_liquid_success",
         "failure":"Black_liquid_failure"}
    ],
    "Black_liquid_success":[
        {"type":"text", "text":"《博物学》⇒ 成功！ <color=blue>{player_roll}<color/>/{player_threshold}", "progression":"click"},
        {"type":"text", "text":"黒い液体からは\n花の蜜の香りとよく似た甘い香りがした。", "progression":"click"},
        {"type":"next_step", "next":"Black_liquid_to_hand"}
    ],
    "Black_liquid_failure":[
        {"type":"text", "text":"《博物学》⇒ 失敗！ <color=red>{player_roll}<color/>/{player_threshold}", "progression":"click"},
        {"type":"text", "text":"黒い液体からは僅かに甘い香りがする。", "progression":"click"},
        {"type":"next_step", "next":"Black_liquid_to_hand"}
    ],
    "Black_liquid_to_hand":[
        {"type":"text", "text":"手に付いた黒い液体をあなたは……", "progression":"click"},
        {"type": "interaction",
         "interactions":[
            {"text":"拭う", "next":"Black_liquid_wipe"},
            {"text":"舐める", "next":"Black_liquid_lick"},
            {"text":"調べる", "next":"Black_liquid_check_up"},
            {"text":"そのままにする", "next":"Black_liquid_nothing"}
        ]}
    ],
    "Black_liquid_wipe":[
        {"type":"text", "text":"黒い液体を服で拭った。", "progression":"click"},
        {"type":"image_hidden"}
    ],
    "Black_liquid_nothing":[
        {"type":"text", "text":"そのまま気にしないことにした。", "progression":"click"},
        {"type":"image_hidden"}
    ],
    "Black_liquid_check_up":[
        {"type": "interaction",
         "interactions":[
            {"text":"医学", "next":"Black_liquid_check_medicine"},
            {"text":"薬学", "next":"Black_liquid_check_pharmacology"}
        ]}
    ],
    "Black_liquid_check_medicine":[
        {"type":"text", "text":"《医学 ÷ 2》⇒", "progression":"click"},
        {"type":"dice_check", "check_type":"skill", "skill":"医学", "half":true, "dice":"1d100",
         "success":"Black_liquid_check_medicine_success",
         "failure":"Black_liquid_check_failure"}
    ],
    "Black_liquid_check_medicine_success":[
        {"type":"text", "text":"《医学 ÷ 2》⇒ 成功！ <color=blue>{player_roll}<color/>/{player_threshold}", "progression":"click"},
        {"type":"next_step", "next":"Black_liquid_check_success"}
    ],
    "Black_liquid_check_medicine_failure":[
        {"type":"text", "text":"《医学 ÷ 2》⇒ 失敗！ <color=red>{player_roll}<color/>/{player_threshold}", "progression":"click"},
        {"type":"next_step", "next":"Black_liquid_check_failure"}
    ],
    "Black_liquid_check_pharmacology":[
        {"type":"text", "text":"《薬学》⇒", "progression":"click"},
        {"type":"dice_check", "check_type":"skill", "skill":"薬学", "dice":"1d100",
         "success":"Black_liquid_check_pharmacology_success",
         "failure":"Black_liquid_check_failure"}
    ],
    "Black_liquid_check_pharmacology_success":[
        {"type":"text", "text":"《薬学》⇒ 成功！ <color=blue>{player_roll}<color/>/{player_threshold}", "progression":"click"},
        {"type":"next_step", "next":"Black_liquid_check_success"}
    ],
    "Black_liquid_check_pharmacology_failure":[
        {"type":"text", "text":"《薬学》⇒ 失敗！ <color=red>{player_roll}<color/>/{player_threshold}", "progression":"click"},
        {"type":"next_step", "next":"Black_liquid_check_failure"}
    ],
    "Black_liquid_check_success":[
        {"type":"text", "text":"あなたはこの液体が猛毒である可能性が\n高いと感じた。", "progression":"click"},
        {"type":"image_hidden"}
    ],
    "Black_liquid_check_failure":[
        {"type":"text", "text":"何も分からなかった。", "progression":"click"},
        {"type":"image_hidden"}
    ],
    "Black_liquid_lick":[
        {"type":"text", "text":"黒い液体を舐めてみた。", "progression":"click"},
        {"type":"image_display", "image":"Squishy_red.gif"},
        {"type":"text", "text":"突然呼吸と脈拍が早くなり、\n幻覚が見えだした。", "progression":"click"},
        {"type":"text", "text":"猛毒を摂取したあなたは\n毒対抗ロールに成功しなければ死んでしまう。", "progression":"click"},
        {"type":"dice_check", "check_type":"VS_passive", "status":"CON", "enemy_status":25, "dice":"1d100",
         "success":"Black_liquid_VS_POT_success",
         "failure":"Black_liquid_VS_POT_failure"}
    ],
    "Black_liquid_VS_POT_success":[
        {"type":"text", "text":"毒対抗ロール ⇒ 成功！ <color=blue>{player_roll}<color/>/{player_threshold}", "progression":"click"},
        {"type":"text", "text":"", "progression":"click"}
    ],
    "Black_liquid_VS_POT_failure":[
        {"type":"text", "text":"毒対抗ロール ⇒ 失敗！ <color=red>{player_roll}<color/>/{player_threshold}", "progression":"click"},
        {"type":"text", "text":"", "progression":"click"}
    ]
}