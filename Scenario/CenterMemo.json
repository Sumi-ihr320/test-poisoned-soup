{
    "centerMemo":[
        {"type":"image_display", "image":"centerMemo1.png"},
        {"type":"text", "text":"1枚目のメモには絵が描かれている。\nおそらくこの部屋の地図だろう。", "progression":"click"},
        {"type":"image_display", "image":"centerMemo2.png"},
        {"type":"text", "text":"もう一枚のメモを手に取ると、\nそこにはこう書かれていた。", "progression":"click"},
        {"type":"text", "text":"～帰りたいなら 一時間以内に 毒入りスープを飲め。\n  飲むまでは 君じゃあここから 出られない。\n  一時間以内に 飲めなかったら お迎えが来るぞ～", "progression":"click"},
        {"type":"conditional", 
         "conditions":[
            {"flags":[
                {"category":"items", "flag":"center_memo_objective", "value":true}
             ],"next":"centerMemo_obj_true"
            },
            {"flags":[
                {"category":"items", "flag":"center_memo_objective", "value":false}
             ],"next":"centerMemo_obj_false"
            }]
        }
    ],
    "centerMemo_obj_true":[
        {"type":"image_display", "image":"centerMemo_objctive.png"},
        {"type":"text", "text":"裏には\n～暖かい 人間の 血の スープ 冷めない 内に 召し上がれ～\nと書かれている。", "progression":"click"},
        {"type":"image_hidden"}
    ],
    "centerMemo_obj_false":[
        {"type":"interaction", "progression":"click",
         "interactions":[
            {"text":"目星", "next":"centerMemo_objective"}]
        }
    ],
    "centerMemo_objective":[
        {"type":"dice_check", "check_type":"skill", "skill":"目星", "dice":"1d100",
         "success":"centerMemo_objective_success",
         "failure":"centerMemo_objective_failure"}
    ],
    "centerMemo_objective_success":[
        {"type":"text", "text":"《目星》⇒ 成功！ <color=blue>{roll}<color/>/{threshold}", "progression":"click"},
        {"type":"text", "text":"あなたは、紙の裏にも文字が書かれていることに気付いた。", "progression":"click"},
        {"type":"action", "action":"set_flag", "category":"items", "flag":"center_memo_objective", "value":true},
        {"type":"image_display", "image":"centerMemo_objctive.png"},
        {"type":"text", "text":"～暖かい 人間の 血の スープ 冷めない 内に 召し上がれ～\n《アイデア》⇒", "progression":"click"},
        {"type":"dice_check", "check_type":"status", "status":"Idea", "dice":"1d100",
         "success":"centerMemo_objective_idea_success",
         "failure":"centerMemo_objective_idea_failure"}
    ],
    "centerMemo_objective_idea_success":[
        {"type":"text", "text":"《アイデア》⇒ 成功！ <color=blue>{roll}<color/>/{threshold}", "progression":"click"},
        {"type":"action", "action":"set_flag", "category":"items", "flag":"soup_know", "value":true},
        {"type":"text", "text":"このスープはどうやら本当に人間の血のようだ。\nそう気付いた途端、スープから鉄錆に似た悪臭が漂ってくる。", "progression":"click"},
        {"type":"text", "text":"このおぞましい事実に気付いてしまったあなたは\n0/1d4のSANチェックだ。", "progression":"click"},
        {"type":"dice_check", "check_type":"status", "status":"SAN", "dice":"1d100",
         "success":"centerMemo_objective_idea_SAN_success",
         "failure":"centerMemo_objective_idea_SAN_failure"}
    ],
    "centerMemo_objective_idea_SAN_success":[
        {"type":"text", "text":"《SAN》⇒ 成功！ <color=blue>{roll}<color/>/{threshold}", "progression":"click"},
        {"type":"text", "text":"あなたは驚いたが正気度は減らずに済んだ", "progression":"click"},
        {"type":"image_hidden"}
    ],
    "centerMemo_objective_idea_SAN_failure":[
        {"type":"text", "text":"《SAN》⇒ 失敗！ <color=red>{roll}<color/>/{threshold}", "progression":"click"},
        {"type":"action", "action":"damage", "status":"SAN", "dice":"1d4"},
        {"type":"text", "text":"おぞましい事実に気づいてしまったあなたは\n{damege}ポイントの正気度を失った", "progression":"click"},
        {"type":"image_hidden"}
    ],
    "centerMemo_objective_idea_failure":[
        {"type":"text", "text":"《アイデア》⇒ 失敗！ <color=red>{roll}<color/>/{threshold}", "progression":"click"},
        {"type":"text", "text":"どういう意味だろうか……", "progression":"click"},
        {"type":"image_hidden"}
    ],
    "centerMemo_objective_failure":[
        {"type":"text", "text":"《目星》⇒ 失敗！ <color=red>{roll}<color/>/{threshold}", "progression":"click"},
        {"type":"text", "text":"何もわからなかった。", "progression":"click"},
        {"type":"image_hidden"}
    ]
}