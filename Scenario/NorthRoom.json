      "false": "Pot_open_only"
    }
  ],
  "Pot_open_girl_question": [
    {
      "type": "interaction",
      "interactions": [
        {
          "text": "一人で中を見る",
          "next": "Pot_open_only"
        },
        {
          "text": "少女と一緒に中を見る",
          "next": "Pot_open_with_girl"
        }
      ]
    }
  ],
  "Pot_open_with_girl": [
    {
      "type": "time_passage",
      "value": 2
    },
    {
      "type": "text",
      "text": "鍋の蓋を開けた。",
      "progression": "click"
    },
    {
      "type": "image_display",
      "image": "Pot_open.png"
    },
    {
      "type": "text",
      "text": "中にはバラバラになった人体が詰まっていた。",
      "progression": "click"
    },
    {
      "type": "conditional",
      "conditions": [
        {
          "if": {
            "pot_looked": false,
            "pot_looked_g": false
          },
          "next": "Pot_open_no_look_with_girl"
        },
        {
          "if": {
            "pot_looked": false,
            "pot_looked_g": true
          },
          "next": "Pot_open_no_look"
        },
        {
          "if": {
            "pot_looked": true,
            "pot_looked_g": false
          },
          "next": "Pot_open_no_look_girl"
        },
        {
          "if": {
            "pot_looked": true,
            "pot_looked_g": true
          },
          "next": "Pot_open_conditions"
        }
      ]
    }
  ],
