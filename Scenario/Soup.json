    ],
    "Soup_medicine_success":[
        {"type":"text", "text":"成功！ {roll}/{threshold}"},
        {"type":"action", "action":"set_flag", "flag_name":"items_flag", "item":"soup", "flag":"know", "value":true},
        {"type":"text", "text":"あなたは医学の知識によって、このスープが確かに人間の血液であることを確信するだろう。\nそう気付いた途端、スープから鉄錆に似た悪臭が漂ってくる。"},
        {"type":"text", "text":"そのことを知ってしまったあなたは0/1d4のSANチェックだ。"},
        {"type":"dice_check", "check_type":"SAN", "dice":"1d100",
         "success":"Soup_medicine_SAN_success",
         "failure":"Soup_medicine_SAN_failure"}
    ],
    "Soup_medicine_SAN_success":[
        {"type":"text", "text":"成功！ {roll}/{threshold}"},
        {"type":"text", "text":"あなたは驚いたが正気度は減らずに済んだ"}
    ],
    "Soup_medicine_SAN_failure":[
