  "Soup_in_poison_objective": [
    {
      "type": "text",
      "text": "黒く染まったスープ。\n表面はどろりと重く、光を吸い込むような色をしている。\n甘い香りが、かすかに漂っている。",
      "progression": "click"
    },
    {
      "type": "image_hidden"
    }    
  ],
  "Soup_in_poison_feel": [
    {
      "type": "text",
      "text": "指先に触れると、黒い液体がぬるりと絡みついてくる。\n粘度が高く、指を離しても糸を引く。\n甘い香りが鼻先をかすめる。",
      "progression": "click"
    },
    {
      "type": "next_step",
      "next": "Poison_adhere_to_finger"
    }
  ],
  "Soup_in_poison_drink": [
    {
      "type": "girl_check",
      "true": "poison_soup_drink_with_girl",
      "false": "poison_soup_drink_only"
    }
  ],
  "Soup_interaction": [
    {
      "type": "interaction",
      "item": "item",
      "interactions": [
        {
          "text": "目星",
          "next": "Soup_objective"
        },
        {
          "text": "医学",
          "next": "Soup_medicine",
          "show_if": {"soup_know": false}
        },
        {
          "text": "触る",
          "next": "Soup_feel"
        },
        {
          "text": "毒を入れる",
          "next": "Soup_poison_in",
          "show_if": {"poison_get": true}
        },
        {
          "text": "飲む",
          "next": "Soup_drink"
        },
        {
          "text": "捨てる",
          "next": "Soup_destruction"
        }
      ]
    }
  ],
  "Soup_objective": [
    {
      "type": "conditional",
      "conditional_type": "text",
      "conditions": [
        {
          "if": {"soup_know": true},
          "texts": [
            {"min_time": 450, "text": "木製の器に入った、真っ赤なスープ。\n湯気が立ち、表面はとろりとしている。\n鉄錆に似た臭いが鼻をつく。"},
            {"min_time": 300, "text": "木製の器に入った、真っ赤なスープ。\n表面はもったりと重く、粘度がある。\n鉄錆に似た臭いが鼻をつく。"},
            {"min_time": 150, "text": "木製の器に入った、真っ赤なスープ。\n表面に粘り気があり、冷めてきているようだ。\n鉄錆に似た臭いが鼻をつく。"},
            {"min_time": 0, "text": "木製の器に入った、真っ赤なスープ。\n表面に薄い膜が張り、すっかり冷たくなっている。\n鉄錆に似た臭いが鼻をつく。"}
          ]
        },
        {
          "if": {"soup_know": false},
          "texts": [
            {"min_time": 450, "text": "木製の器に入った、真っ赤なスープ。\n湯気が立ち、表面はとろりとしている。\n不思議なことに、匂いはまったくしない。"},
            {"min_time": 300, "text": "木製の器に入った、真っ赤なスープ。\n表面はもったりと重く、粘度がある。\n匂いはまったくしない。"},
            {"min_time": 150, "text": "木製の器に入った、真っ赤なスープ。\n表面に粘り気があり、冷めてきているようだ。\n匂いはまったくしない。"},
            {"min_time": 0, "text": "木製の器に入った、真っ赤なスープ。\n表面に薄い膜が張り、すっかり冷たくなっている。\n匂いはまったくしない。"}
          ]
        }
      ]
    },
    {
      "type": "image_hidden"
    }  
  ],
  "Soup_medicine": [
    {
      "type": "conditional",
      "conditions":[
        {
          "if": {"light_remove": false},
          "next": "Soup_medicine_clear"
        },
        {
          "if": {
            "candle_get": true,
            "candle_goes_out": 0
          },
          "next": "Soup_medicine_clear"
        },
        {
          "if": "else",
          "next": "Soup_medicine_dark"
        }
      ]
    }
  ],
  "Soup_medicine_clear":[
    {
      "type": "dice_check",
      "check_type": "skill",
      "skill": "医学",
      "progression": "click",
      "on_success": "Soup_medicine_success",
      "on_failure": "Soup_medicine_failure"
    }
  ],
  "Soup_medicine_dark":[
    {
      "type": "dice_check",
      "check_type": "skill",
      "skill": "医学",
      "half": true,
      "progression": "click",
      "on_success": "Soup_medicine_success",
      "on_failure": "Soup_medicine_failure"
    }
  ],
  "Soup_medicine_success": [
    {
      "type": "action",
      "action": "set_flag",
      "flag": {"soup_know": true}
    },
    {
      "type": "text",
      "text": "あなたは医学の知識によって、\nこのスープが確かに人間の血液であることを確信するだろう。\nそう気付いた途端、スープから鉄錆に似た悪臭が漂ってくる。",
      "progression": "click"
    },
    {
      "type": "text",
      "text": "そのことを知ってしまったあなたは\n0/1d4のSANチェックだ。",
      "progression": "click"
    },
    {
      "type": "dice_check",
      "check_type": "SANチェック"
    },
    {
      "type": "damage",
      "text": "おぞましい事実に気づいてしまった",
      "damage": {
        "type": "branch",
        "target": "SAN",
        "success": {
          "type": "fixed",
          "value": 0
        },
        "failure": {
          "type": "dice",
          "spec": "1d4"
        }
      }
    },
    {
      "type": "image_hidden"
    }
  ],
  "Soup_medicine_failure": [
    {
      "type": "text",
      "text": "何もわからなかった。",
      "progression": "click"
    },
    {
      "type": "image_hidden"
    }
  ],
  "Soup_feel":[
    {
      "type": "conditional",
      "conditional_type": "text",
      "conditions":[
        {
          "if": {"soup_know": true},
          "texts":[
            {"min_time": 450, "text": "指先に伝わる熱が、妙に生々しく感じる。\nとろりと重く指に絡みつくそれは——\n温かいまま、ここに置かれていたのだ。"},
            {"min_time": 300, "text": "まだ温かい。\nそれがかえって、直視したくない事実を突きつけてくる。\n指に纏わりつく粘度が、じわりと不快感を呼び起こす。"},
            {"min_time": 150, "text": "ぬるい。体温に近い温度が、余計に気持ち悪い。\n指を離すと糸を引く——これがかつて\n誰かの体の中にあったものだと思うと、手を洗いたくなる。"},
            {"min_time": 0, "text": "表面を覆う膜に触れると、ずるりと指が沈む。\n冷たく固まりかけたそれは、もうスープですらない。\n触れたくないという本能が、じわりと湧き上がる。"}
          ]
        },
        {
          "if": {"soup_know": false},
          "texts":[
            {"min_time": 450, "text": "指先に伝わる熱と、とろりとした重さ。\n水よりも粘り気があり、ゆっくりと指に絡みついてくる。\n……スープにしては、少し重いかもしれない。"},
            {"min_time": 300, "text": "かすかな温もりと、もったりとした重さが指に伝わる。\n粘り気があり、水とは明らかに違う感触だ"},
            {"min_time": 150, "text": "ぬるく、纏わりつくような粘度がある。\n指を離すと糸を引くように感じる。妙に、重い。"},
            {"min_time": 0, "text": "表面に薄い膜が張っている。指で触れると、ずるりと破れて沈む。\n冷たく、重い——\nもはやスープとは呼びにくい何かになっている。"}
          ]
        }
      ]
    },
    {
      "type": "image_hidden"
    }
  ],
