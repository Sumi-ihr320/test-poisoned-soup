{
    "east-room":[
        {"type":"conditional", "conditions":[
            {"flags":[
                {"category":"rooms", "flag":"east_room_visivle", "value":false},
                {"category":"characters", "flag":"girl_fellow", "value":false},
                {"category":"characters", "flag":"girl_death", "value":false}
            ], "next":"east-room_visivle_girl_false"},
            {"flags":[{"category":"rooms", "flag":"east_room_visivle", "value":true}], "next":"east-room_visivle_true"}
        ]}
    ],
    "east-room_visivle_true":[
        {"type":"text", "text":"中は真っ暗だ。", "progression":"click"}
    ],
    "east-room_visivle_girl_false":[
        {"type":"text", "text":"中は真っ暗で、\n中央の部屋の明かりも奥までは届かないようだ。", "progression":"click"},
        {"type":"interaction",
         "interactions":[
            {"text":"目星", "next":"east-room_spot_hidden"},
            {"text":"聞き耳", "next":"east-room_listen"},
            {"text":"中を歩く", "next":""},
            {"text":"中を走る", "next":""}
         ]}
    ],
    "east-room_spot_hidden":[
        {"type":"action", "action":"set_flag", "category":"rooms", "flag":"east_room_time", "value":"+1"},
        {"type":"dice_check", "check_type":"skill", "skill":"目星", "dice":"1d100",
         "success":"east-room_spot_hidden_success",
         "failure":"east-room_spot_hidden_failure"}
    ],
    "east-room_spot_hidden_success": [
        {"type":"text", "text":"成功！ {roll}/{threshold}", "progression":"click"},
        {"type": "text", "text": "よく目を凝らすと中がうっすらと見えるようになった", "progression":"click"},
        {"type":"action", "action":"set_flag", "category":"rooms", "flag":"east_room_visivle", "value":true}
    ],
    "east-room_spot_hidden_failure":[
        {"type":"text", "text":"失敗！ {roll}/{threshold}", "progression":"click"},
        {"type": "text", "text": "何も見えない", "progression":"click"}
    ],
    "east-room_listen":[
        {"type":"action", "action":"set_flag", "category":"rooms", "flag":"east_room_time", "value":"+1"},
        {"type":"dice_check", "check_type":"skill", "skill":"聞き耳", "dice":"1d100",
         "success": "east-room_listen_success",
         "failure": "east-room_listen_failure"}
    ],
    "east-room_listen_success": [
        {"type":"text", "text":"成功！ {roll}/{threshold}", "progression":"click"},
        {"type": "text", "text": "ひたひたという足音が近づいて来ているようだ。", "progression":"click"}
    ],
    "east-room_listen_failure":[
        {"type":"text", "text":"失敗！ {roll}/{threshold}", "progression":"click"},
        {"type": "text", "text": "特に何も聞こえなかった。"}
    ]
}