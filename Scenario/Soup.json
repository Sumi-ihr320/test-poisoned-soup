    "Soup_medicine":[
        {"type":"dice_check", "check_type":"skill", "skill":"医学", "dice":"1d100",
         "success":"Soup_medicine_success",
         "failure":"Soup_medicine_failure"}
    ],
    "Soup_medicine_success":[
        {"type":"text", "text":"《医学》⇒ 成功！ {roll}/{threshold}", "progression":"click"},
        {"type":"action", "action":"set_flag", "category":"items", "item":"soup", "flag":"know", "value":true},
        {"type":"text", "text":"あなたは医学の知識によって、\nこのスープが確かに人間の血液であることを確信するだろう。\nそう気付いた途端、スープから鉄錆に似た悪臭が漂ってくる。", "progression":"click"},
        {"type":"text", "text":"そのことを知ってしまったあなたは\n0/1d4のSANチェックだ。", "progression":"click"},
        {"type":"dice_check", "check_type":"status", "status":"SAN", "dice":"1d100",
         "success":"Soup_medicine_SAN_success",
         "failure":"Soup_medicine_SAN_failure"}
    ],
    "Soup_medicine_SAN_success":[
        {"type":"text", "text":"《SAN》⇒ 成功！ {roll}/{threshold}", "progression":"click"},
        {"type":"text", "text":"あなたは驚いたが正気度は減らずに済んだ", "progression":"click"},
        {"type":"image_hidden"}
    ],
    "Soup_medicine_SAN_failure":[
        {"type":"text", "text":"《SAN》⇒ 失敗！ {roll}/{threshold}", "progression":"click"},
        {"type":"damage", "dice":"1d4"},
        {"type":"text", "text":"おぞましい事実に気づいてしまったあなたは\n{damege}ポイントの正気度を失った", "progression":"click"},
        {"type":"action", "action":"damage", "status":"SAN", "damage":0},
        {"type":"image_hidden"}
    ],
    "Soup_medicine_failure":[
        {"type":"text", "text":"《医学》⇒ 失敗！ {roll}/{threshold}", "progression":"click"},
        {"type":"text", "text":"何もわからなかった。", "progression":"click"},
        {"type":"image_hidden"}
    ],
    "Soup_destruction":[
        {"type":"text", "text":"あなたはスープを捨てることにした。", "progression":"click"},
        {"type":"conditional",
         "conditions":[
            {"flags":[{"category":"characters","flag":"girl_fellow", "value":true}], "next":"Soup_destruction_with_girl"},
            {"flags":[{"category":"characters","flag":"girl_fellow", "value":false}], "next":"Soup_destruction_only_me"}
         ]}
    ],
