{
  "Candle": [
    {
      "type": "conditional",
      "conditional_type": "image",
      "conditions": [
        {
          "if": {"candle_goes_out": 0},
          "images": [
            {"min_time": 450, "image": "Candle1.png"},
            {"min_time": 150, "image": "Candle2.png"}
          ],
          "next": "Candle_lit"
        },
        {
          "if": {"time": {"<": 150}},
          "image": "Candle3.png",
          "next": "Candle_burnt_out"
        },
        {
          "if": {"candle_goes_out": 1},
          "image": "Candle1_goes_out.png",
          "next": "Candle_goes_out"
        },
        {
          "if": {"candle_goes_out": 2},
          "image": "Candle2_goes_out.png",
          "next": "Candle_goes_out"
        }
      ]
    }
  ],
  "Candle_lit": [
    {
      "type": "text",
      "text": "ろうそくの炎が揺らめいている。",
      "progression": "click"
    },
    { 
      "type": "next_step",
      "next": "Candle_interaction"
    }
  ],
  "Candle_goes_out": [
    {
      "type": "text",
      "text": "火が消えたろうそくがある。",
      "progression": "click"
    },
    { 
      "type": "next_step",
      "next": "Candle_interaction"
    }
  ],
  "Candle_interaction": [
    {
      "type": "interaction",
      "interactions": [
        {
          "text": "目星",
          "next": "Candle_objective",
          "show_if": {"candle_goes_out": 0}
        },
        {
          "text": "目星",
          "next": "Candle_goes_out_objective",
          "show_if": {"candle_goes_out": {"!=": 0}}
        },
        {
          "text": "消す",
          "next": "Candle_put_out",
          "show_if": {"candle_goes_out": 0,
                      "time": {">" : 150}}
        },
        {
          "text": "持っていく",
          "next": "Candle_take_it"
        }
      ]
    }
  ],
  "Candle_objective": [
    {
      "type": "dice_check",
      "check_type": "skill",
      "skill": "目星",
      "dice": "1d100",
      "progression": "click",
      "on_success": "Candle_objective_success",
      "on_failure": "Candle_objective_failure"
    }
  ],
  "Candle_goes_out_objective": [
    {
      "type": "dice_check",
      "check_type": "skill",
      "skill": "目星",
      "dice": "1d100",
      "half": true,
      "progression": "click",
      "on_success": "Candle_objective_success",
      "on_failure": "Candle_objective_failure"
    }
  ],
  "Candle_objective_success": [
    {
      "type": "conditional",
      "conditional_type": "text",
      "conditions":[
        {
          "if": {"candle_goes_out": 0},
          "texts":[
            {"min_time": 400, "text": "何の変哲もない普通のろうそくだ。\n蝋はあとしばらくはもつだろう。"},
            {"min_time": 150, "text": "何の変哲もない普通のろうそくだ。\n蝋はもう半分ほどに減っている。"}
          ]
        },
        {
          "if": {"candle_goes_out": 1},
          "text": "何の変哲もない普通のろうそくだ。\n蝋の長さはまだ余裕がありそうだ。"
        },
        {
          "if": {"candle_goes_out": 2},
          "text": "何の変哲もない普通のろうそくだ。\n蝋の長さは半分ほどに減っている。"
        }
      ]
    },
    {
      "type": "image_hidden"
    }
  ],
  "Candle_put_out": [
    {
      "type": "conditional",
      "conditional_type": "image_and_flag",
      "conditions":[
        {
          "if": {"time": {">": 400}},
          "image": "Candle1_goes_out.png",
          "flag": {"candle_goes_out": 1}
        },
        {
          "if": {"time": {">": 150}},
          "image": "Candle2_goes_out.png",
          "flag": {"candle_goes_out": 2}
        }
      ]
    },
    {
      "type": "text",
      "text": "ろうそくを吹き消した。",
      "progression": "click"
    },
    {
      "type": "text",
      "text": "明かりがなくなったため部屋が暗くなった。",
      "progression": "click"
    },
    {
      "type": "text",
      "text": "探し物が難しくなりそうだ。",
      "progression": "click"
    },
    {
      "type": "image_hidden"
    }
  ],
  "Candle_take_it": [
    {
      "type": "conditional",
      "conditional_type":"item",
      "conditions":[
        {
          "if": {"candle_goes_out": 0},
          "items": [
            {"min_time": 450, "item": "candle1"},
            {"min_time": 150, "item": "candle2"}
          ]
        },
        {
          "if": {"candle_goes_out": 1},
          "item": "candle_goes_out1"
        },
        {
          "if": {"candle_goes_out": 2},
          "item": "candle_goes_out2"
        }
      ],
      "next": "Candle_get"
    }
  ],
  "Candle_get": [
    {
      "type": "text",
      "text": "ろうそくを持って行くことにした。",
      "progression": "click"
    },
    {
      "type": "action",
      "action": "set_flag",
      "flag": {"candle_get": true}
    },
    {
      "type": "text",
      "text": "ろうそくを手に入れた。",
      "progression": "click"
    },
    {
      "type": "image_hidden"
    }
  ],
  "Candle_burnt_out": [
    {
      "type": "image_display",
      "image": "Candle3.png"
    },
    {
      "type": "text",
      "text": "ろうそくは燃え尽きてしまっている。",
      "progression": "click"
    },
    {
      "type": "image_hidden"
    }
  ],
  "Candle_objective_failure": [
    {
      "type": "text",
      "text": "普通のろうそくだ。",
      "progression": "click"
    },
    {
      "type": "image_hidden"
    }
  ]
}