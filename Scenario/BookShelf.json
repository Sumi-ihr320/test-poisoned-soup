{
  "BookShelf": [
    {
      "type": "text",
      "text": "大きな本棚がある。",
      "progression": "click"
    },
    {
      "type": "conditional",
      "conditional_type": "text",
      "conditions": [
        {
          "if": {"bookshelf_objective": true},
