        {"type":"text", "text":"本当に捨てていいのか？と問うているようだ。", "progression":"click"},
        {"type":"interaction", "item":"Soup",
        "interactions":[
                {"text":"捨てる", "next":"Soup_destruction_only_me"},
                {"text":"捨てない", "next":"Soup_not_destruction"}
