      "text": "中は真っ暗で、\n中央の部屋の明かりも奥までは届かないようだ。",
      "progression": "click"
    },
    {
      "type": "conditional",
      "conditions": [
        {
          "if": {
            "east_room_visible": true,
            "east_room_listen": true,
            "meet": false
          },
          "next": "east-room_visible_listen_not_meet"
        },
        {
          "if": {
            "meet": true,
            "fellow": false,
            "room": "east"
          },
          "next": "Girl_room_wait"
        },
        {
          "if": "else",
          "next": "east_room_interaction"
        }
      ]
    }
  ],
