{
  "Soup": [
    {
      "type": "image_display",
      "image": "Soup.png"
    },
    {
      "type": "conditional",
      "conditional_type": "text",
      "conditions":[
        {
          "if": {"soup_know": true},
          "texts":[
            {"min_time": 450, "text": "人間の血のスープだ。湯気が立っている。\n鉄錆に似た悪臭がスープから漂ってくる…"},
            {"min_time": 0, "text": "人間の血のスープだ。\n鉄錆に似た悪臭がスープから漂ってくる…"}
          ]
        },
        {
          "if": {"soup_know": false},
          "texts":[
            {"min_time": 450, "text": "赤い無臭のスープだ。湯気が立っている。"},
            {"min_time": 0, "text": "赤い無臭のスープだ。"}
          ]
        }
      ],
      "next": "Soup_interaction"
    }
  ],
  "Soup_none": [
    {
      "type": "image_display",
      "image": "Soup_none.png"
    },
    {
      "type": "conditional",
      "conditional_type": "text",
      "conditions": [
        {
          "if": {"soup_drink": true},
          "text": "飲み干してしまったスープの器。中身は空だ。"
        },
        {
          "if": {"soup_destruction": true},
          "text": "スープの器。捨ててしまったので中身は空だ。"
        }
      ],
      "next": "Soup_bowl_interaction"
    }
  ],
  "Soup_bowl_interaction": [
    {
      "type": "interaction",
      "target": "item",
      "interactions": [
        {
          "text": "持って行く",
          "next": "Soup_bowl_get"
        },
        {
          "text": "何もしない",
          "next": "Soup_bowl_none"
        }
      ]
    }
  ],
